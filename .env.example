# Copy to .env and adjust for local development.
# Never commit real credentials.
# Quick start: bash scripts/bootstrap_env.sh

# PostgreSQL (shared instance — separate DBs per environment)
POSTGRES_USER=traffic_admin
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# Environment separation: dev | staging | prod
# Controls which dbt target and warehouse database are used.
DEPLOY_ENV=dev

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=generate_a_fernet_key_here
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@traffic.local

# Redash
REDASH_PORT=5000
REDASH_SECRET_KEY=generate_a_redash_secret_key_here
REDASH_COOKIE_SECRET=generate_a_redash_cookie_secret_here

# dbt
DBT_PROFILES_DIR=./dbt
DBT_DOCS_PORT=8081
